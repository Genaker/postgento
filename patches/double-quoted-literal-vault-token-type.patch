--- a/app/code/Magento/Vault/Setup/Patch/Data/SetCreditCardAsDefaultTokenType.php
+++ b/app/code/Magento/Vault/Setup/Patch/Data/SetCreditCardAsDefaultTokenType.php
@@ -42,12 +42,16 @@
 
         // data update for Vault module < 2.0.1
         // update sets credit card as default token type
+        // PgCompat: was ' = ""' - a double-quoted empty-string literal, MySQL-only
